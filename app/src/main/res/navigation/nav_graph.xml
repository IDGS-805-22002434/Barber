<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.tovar.barbermanager.ui.home.HomeFragment"
        android:label="@string/nav_home">

        <action
            android:id="@+id/action_home_to_services"
            app:destination="@id/servicesFragment" />

        <action
            android:id="@+id/action_home_to_barbers"
            app:destination="@id/barbersFragment" />

        <action
            android:id="@+id/action_home_to_booking"
            app:destination="@id/bookingFragment" />
    </fragment>

    <fragment
        android:id="@+id/servicesFragment"
        android:name="com.tovar.barbermanager.ui.services.ServicesFragment"
        android:label="@string/services_title">

        <action
            android:id="@+id/action_services_to_form"
            app:destination="@id/serviceFormFragment" />
    </fragment>

    <fragment
        android:id="@+id/serviceFormFragment"
        android:name="com.tovar.barbermanager.ui.services.ServiceFormFragment"
        android:label="@string/service_form_new_title">

        <argument
            android:name="serviceId"
            app:argType="long"
            android:defaultValue="0L" />
    </fragment>

    <fragment
        android:id="@+id/barbersFragment"
        android:name="com.tovar.barbermanager.ui.barbers.BarbersFragment"
        android:label="@string/barbers_title">

        <action
            android:id="@+id/action_barbers_to_form"
            app:destination="@id/barberFormFragment" />

        <action
            android:id="@+id/action_barbers_to_specialties"
            app:destination="@id/specialtiesFragment" />
    </fragment>

    <fragment
        android:id="@+id/barberFormFragment"
        android:name="com.tovar.barbermanager.ui.barbers.BarberFormFragment"
        android:label="@string/barber_form_new_title">

        <argument
            android:name="barberId"
            app:argType="long"
            android:defaultValue="0L" />

        <action
            android:id="@+id/action_barberForm_to_schedule"
            app:destination="@id/scheduleFragment" />
    </fragment>

    <fragment
        android:id="@+id/scheduleFragment"
        android:name="com.tovar.barbermanager.ui.schedule.ScheduleFragment"
        android:label="@string/schedule_title"
        tools:layout="@layout/fragment_schedule">

        <argument
            android:name="barberId"
            app:argType="long"
            android:defaultValue="0L" />
    </fragment>

    <fragment
        android:id="@+id/appointmentsFragment"
        android:name="com.tovar.barbermanager.ui.appointments.AppointmentsFragment"
        android:label="@string/appointments_title"
        tools:layout="@layout/fragment_appointments">

        <action
            android:id="@+id/action_appointments_to_booking"
            app:destination="@id/bookingFragment" />

        <action
            android:id="@+id/action_appointments_to_receipt"
            app:destination="@id/receiptFragment" />
    </fragment>

    <!-- appointmentId = 0: cita nueva; distinto de 0: reprogramar esa cita -->
    <fragment
        android:id="@+id/bookingFragment"
        android:name="com.tovar.barbermanager.ui.appointments.BookingFragment"
        android:label="@string/booking_title"
        tools:layout="@layout/fragment_booking">

        <argument
            android:name="appointmentId"
            app:argType="long"
            android:defaultValue="0L" />

        <action
            android:id="@+id/action_booking_to_receipt"
            app:destination="@id/receiptFragment"
            app:popUpTo="@id/bookingFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/receiptFragment"
        android:name="com.tovar.barbermanager.ui.appointments.ReceiptFragment"
        android:label="@string/receipt_title"
        tools:layout="@layout/fragment_receipt">

        <argument
            android:name="appointmentId"
            app:argType="long"
            android:defaultValue="0L" />
    </fragment>

    <fragment
        android:id="@+id/specialtiesFragment"
        android:name="com.tovar.barbermanager.ui.specialties.SpecialtiesFragment"
        android:label="@string/specialties_title" />
</navigation>
